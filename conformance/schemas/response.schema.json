  "$id": "response.schema.json",
  "title": "ShapeSQL conformance adapter response 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "case_id", "outcome"],
  "properties": {
    "protocol_version": {
