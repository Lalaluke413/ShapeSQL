{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request.schema.json",
  "title": "ShapeSQL conformance adapter request 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "case_id", "source", "catalog", "snapshot"],
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "case_id": {
      "$ref": "manifest.schema.json#/$defs/case_id"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "contents"],
          "properties": {
            "encoding": {
              "const": "utf-8"
            },
            "contents": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "contents"],
          "properties": {
            "encoding": {
              "const": "base64"
            },
            "contents": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        }
      ]
    },
    "catalog": {
      "$ref": "catalog.schema.json"
    },
    "snapshot": {
      "$ref": "snapshot.schema.json"
    }
  }
}
